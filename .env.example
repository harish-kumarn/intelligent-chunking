# ---------------------------------------------------------------- server ----
# development|debug|local → console logs + file; anything else → JSON logs
APP_ENV=development
# debug → keep each document's workspace in DEBUG_WORKSPACE; production → INGEST_WORKSPACE_DIR, removed on
# success, kept on failure so a retry resumes. The workspace root also holds _jobs/ (job records) and _uploads/.
ARTIFACT_MODE=debug
DEBUG_WORKSPACE=debug
# INGEST_WORKSPACE_DIR=/srv/ingest_workspace   # persistent volume: jobs and resumes survive a restart
# INGEST_JOB_MAX_ATTEMPTS=3                    # runs per ingestion job (each resumes from the workspace)
# INGEST_JOB_RETRY_DELAY_SECONDS=60            # wait before run n+1 = n × this
# INGEST_JOB_AUTO_RESUME=true                  # continue an interrupted job at startup
# MAX_PDF_PAGES=2000
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# 200 MiB
MAX_UPLOAD_SIZE_BYTES=209715200
LOG_LEVEL=INFO

# ------------------------------------------------------------- providers ----
# Gemini — chunking, auto-grounding (required)
GOOGLE_API_KEY=
# OCR backend "mistral" (required when ocr.technique=mistral)
MISTRAL_API_KEY=
# embeddings + rerank (required for retrieval and Milvus upload)
COHERE_API_KEY=
# query reformulation, optional vocabulary dedupe (optional)
GROQ_API_KEY=

# ------------------------------------------------------------------- ocr ----
# Engine is chosen in config.yaml (ocr.technique: mistral|azure; default mistral).
# Uncomment to override the file without editing it.
# OCR_TECHNIQUE=mistral

# Azure AI Document Intelligence — required when ocr.technique=azure
AZURE_OCR_ENDPOINT=
AZURE_OCR_KEY=
# override config.yaml's ocr.azure block
# AZURE_OCR_MODEL=prebuilt-layout
# AZURE_OCR_EXTRACT_FIGURES=true
# AZURE_OCR_FIGURE_DPI=200

# -------------------------------------------------------- classification ----
# Stage 5 (main/sub category per chunk) is configured in config.yaml (classification:).
# Uncomment to override the file without editing it.
# CLASSIFICATION_ENABLED=true
# CLASSIFICATION_ALLOW_NEW_CATEGORIES=true
# CLASSIFICATION_CATEGORIES='["operation", "technical", "safety", "maintenance", "troubleshooting"]'

# ---------------------------------------------------------------- milvus ----
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# or MILVUS_USER / MILVUS_PASSWORD
# MILVUS_TOKEN=
# true → https://
# MILVUS_SECURE=false

# ------------------------------------------------------ language profiles ----
# Each collection holds one language, detected per PDF (or forced with the `language`
# form field of the first document of a new collection). A collection keeps the models it was built with;
# these only affect collections created from now on.
# EMBEDDING_MODEL=embed-v4.0
# RERANKING_MODEL=rerank-english-v3.0
# JAPANESE_EMBEDDING_MODEL=embed-v4.0
# JAPANESE_RERANKING_MODEL=rerank-v3.5
# share of Japanese script among a PDF's letters that makes it Japanese
# JAPANESE_DETECTION_THRESHOLD=0.2
# fetch Milvus' Lindera dictionary at startup (needs Milvus 2.6+)
# WARM_UP_JAPANESE_ANALYZER=true

# -------------------------------------------------------------------- s3 ----
# true → publish each ingestion's artifacts under its content hash
S3_UPLOAD_ENABLED=false
# default bucket when a request does not name one
S3_BUCKET=
AWS_DEFAULT_REGION=
# Static credentials read from this file / the environment. Leave blank to use
# boto3's standard chain instead (~/.aws profile, IAM role, ECS task role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# only for temporary (STS) credentials
# AWS_SESSION_TOKEN=
# fallback region when AWS_DEFAULT_REGION is unset
# AWS_DEFAULT_REGION=
